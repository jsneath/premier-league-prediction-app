# MongoDB connection string
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# JWT secret key — MUST be long and random, never a guessable word.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=your-jwt-secret-here

# API-Football key (from RapidAPI)
API_FOOTBALL_KEY=your-rapidapi-key-here

# Season to play. API-Football names a season by its starting year,
# so 2026 = the 2026/27 season. Bump this each August.
API_FOOTBALL_SEASON=2026

# xAI API key — powers "The Pundit" weekly Grok banter reports.
# Optional: if unset, the app runs normally and just skips the reports.
# Create a key at https://console.x.ai
XAI_API_KEY=your-xai-api-key-here

# Gmail credentials for password reset emails
# Use an App Password, not your regular Gmail password
# https://myaccount.google.com/apppasswords
# NOTE: Render's free tier blocks outbound SMTP, so reset emails will not
# send in production there. Reset passwords directly in MongoDB instead.
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password-here

# Frontend URL (used for CORS and password reset links)
FRONTEND_URL=http://localhost:3000
